{
	"name": "react-native-call-log",
	"version": "3.0.0",
	"description": "Access and query call history log for Android in React Native",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"source": "src/index.ts",
	"files": [
		"lib",
		"src",
		"android",
		"!**/__tests__",
		"!**/__fixtures__",
		"!**/__mocks__",
		"!**/.*"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf lib",
		"prepare": "npm run clean && npm run build",
		"test": "echo \"Error: no test specified\" && exit 1",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/wscodelabs/react-native-call-log.git"
	},
	"keywords": [
		"react-native",
		"android",
		"call-log",
		"call-history",
		"phone",
		"contacts",
		"npm",
		"react-native-package",
		"turbomodule",
		"new-architecture"
	],
	"author": "wscodelabs",
	"license": "MIT",
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-native": ">=0.71.0"
	},
	"devDependencies": {
		"@types/node": "^25.0.9",
		"@types/react": "^18.2.0",
		"@types/react-native": "^0.72.0",
		"react": "^18.2.0",
		"react-native": "^0.73.0",
		"typescript": "^5.3.0"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"codegenConfig": {
		"name": "RNCallLogsSpec",
		"type": "modules",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "com.txbody.callLogs"
		}
	}
}
